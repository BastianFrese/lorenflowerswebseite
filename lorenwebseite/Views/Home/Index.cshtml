@{
    ViewData["Title"] = "Loren Flowers";
}

<section class="hero-section" id="start">
    <div class="container site-container">
        <div class="hero-grid">
            <div>
                <span class="section-kicker">Loren Flowers · Bad Sooden-Allendorf</span>
                <h1 class="hero-title">Blumenkunst für jeden Anlass – modern, persönlich und mit über 20 Jahren Erfahrung.</h1>
                <p class="hero-text">
                    Loren Flowers verbindet ausdrucksstarke florale Gestaltung mit zeitgemäßem Design.
                    Von liebevoll gebundenen Sträußen bis zu individuellen Dekorationen entsteht jedes Arrangement mit Gefühl und einer klaren Handschrift.
                </p>
                <div class="hero-actions">
                    <a class="btn btn-shop btn-lg" href="https://loren-flowers.shop" target="_blank" rel="noreferrer">Zum Shop</a>
                    <a class="btn btn-outline-light btn-lg" href="https://loren-flowers.shop/Home/Contact" target="_blank" rel="noreferrer">Kontakt aufnehmen</a>
                </div>
                <div class="hero-stats">
                    <div class="stat-card">
                        <strong>20+</strong>
                        <span>Jahre floristische Erfahrung</span>
                    </div>
                    <div class="stat-card">
                        <strong>Individuell</strong>
                        <span>Arrangements passend zu Anlass und Stil</span>
                    </div>
                    <div class="stat-card">
                        <strong>Mit Herz</strong>
                        <span>Handgebunden und sorgfältig gestaltet</span>
                    </div>
                </div>
            </div>
            <div class="hero-panel">
                <div class="hero-badge">Floristik mit Persönlichkeit</div>
                <h2>Natürliche Eleganz für Alltag, Feier und besondere Wünsche.</h2>
                <p>
                    Farbenfrohe Inspiration aus Odesa trifft auf moderne europäische Gestaltung – für Blumenkreationen,
                    die warm, hochwertig und unverwechselbar wirken.
                </p>
                <ul class="hero-list">
                    <li>Blumensträuße für Geschenk und Zuhause</li>
                    <li>Dekorationen für Hochzeit, Event und saisonale Anlässe</li>
                    <li>Trockenblumen und florale Details mit langlebigem Charakter</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="content-section" id="angebote">
    <div class="container site-container">
        <div class="section-heading">
            <span class="section-kicker">Sträuße & Dekoration</span>
            <h2>Unsere floralen Schwerpunkte</h2>
            <p>Ausgewählte Leistungen für liebevolle Geschenke, saisonale Dekorationen und besondere Momente.</p>
        </div>

        <div class="card-grid">
            <article class="info-card">
                <span class="card-icon">🌷</span>
                <h3>Blumensträuße</h3>
                <p>Handgebundene Sträuße mit feiner Farbkomposition – klassisch, modern oder emotional inszeniert.</p>
            </article>
            <article class="info-card">
                <span class="card-icon">✨</span>
                <h3>Blumendekoration</h3>
                <p>Gestaltung für Tisch, Raum und Feier – abgestimmt auf Stimmung, Stil und Anlass.</p>
            </article>
            <article class="info-card">
                <span class="card-icon">🌾</span>
                <h3>Trockenblumen</h3>
                <p>Moderne, langlebige Arrangements mit natürlicher Struktur und zeitloser Wirkung.</p>
            </article>
        </div>
    </div>
</section>

<section class="content-section content-section-alt" id="ueber-uns">
    <div class="container site-container about-grid">
        <div>
            <span class="section-kicker">Über Loren Flowers</span>
            <h2>Floristik, die Emotionen sichtbar macht.</h2>
            <p>
                Hinter Loren Flowers steht Larisa – Floristin mit Leidenschaft, Erfahrung und einem Gespür für starke Kompositionen.
                Ihre floristische Reise begann in Odesa, Ukraine, wo Blumenkunst ein besonders ausdrucksstarker Teil der Kultur ist.
            </p>
            <p>
                Heute verbindet sie diesen Stil mit moderner europäischer Ästhetik. So entstehen Werkstücke,
                die hochwertig, persönlich und immer auf den jeweiligen Anlass abgestimmt sind.
            </p>
        </div>

        <div class="feature-stack">
            <div class="feature-item">
                <h3>Ukrainische Handschrift</h3>
                <p>Farbenfroh, emotional und mit besonderer Präsenz gestaltet.</p>
            </div>
            <div class="feature-item">
                <h3>Persönlich abgestimmt</h3>
                <p>Jedes Arrangement orientiert sich an Wunsch, Persönlichkeit und Anlass.</p>
            </div>
            <div class="feature-item">
                <h3>Zeitgemäß & sauber</h3>
                <p>Moderne Optik, klare Formen und ein freundlicher, hochwertiger Gesamteindruck.</p>
            </div>
        </div>
    </div>
</section>

<section class="content-section" id="kontakt">
    <div class="container site-container">
        <div class="contact-banner">
            <div>
                <span class="section-kicker">Kontakt & Anfrage</span>
                <h2>Sie planen etwas Besonderes?</h2>
                <p>
                    Ob Geschenk, Hochzeit, Trauerfloristik oder individuelle Dekoration – Loren Flowers gestaltet florale Konzepte,
                    die zu Ihrem Anlass passen und in Erinnerung bleiben.
                </p>
                <p class="contact-location">Standort: Bad Sooden-Allendorf</p>
            </div>
            <div class="contact-actions">
                <a class="btn btn-shop btn-lg" href="https://loren-flowers.shop" target="_blank" rel="noreferrer">Shop öffnen</a>
                <a class="btn btn-outline-secondary btn-lg" href="https://loren-flowers.shop/Home/Privacy" target="_blank" rel="noreferrer">Datenschutz</a>
            </div>
        </div>
    </div>
</section>
