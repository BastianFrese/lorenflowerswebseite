@{
    ViewData["Title"] = "Datenschutz";
}

<section class="content-section privacy-section">
    <div class="container site-container">
        <div class="section-heading section-heading-left">
            <span class="section-kicker">Rechtliches</span>
            <h1>@ViewData["Title"]</h1>
            <p>
                Diese Beispielseite dient als Platzhalter für Ihre vollständigen Datenschutzinformationen.
                Ergänzen Sie hier Angaben zur Verarbeitung personenbezogener Daten, zu Kontaktformularen,
                Cookies, Hosting und eingebundenen Drittanbietern.
            </p>
        </div>
    </div>
</section>
